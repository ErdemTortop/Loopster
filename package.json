{
  "name": "loopster",
  "private": true,
  "version": "1.1.0",
  "description": "Tab player and practice tool for Guitar Pro files",
  "author": "ErdemTortop",
  "license": "MIT",
  "homepage": "https://github.com/ErdemTortop/Loopster",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErdemTortop/Loopster.git"
  },
  "bugs": {
    "url": "https://github.com/ErdemTortop/Loopster/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "dev.loopster.app",
    "productName": "Loopster",
    "artifactName": "Loopster-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "gp",
          "gp3",
          "gp4",
          "gp5",
          "gpx"
        ],
        "name": "Guitar Pro tab",
        "description": "Guitar Pro tab dosyasi",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "publish": null
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
